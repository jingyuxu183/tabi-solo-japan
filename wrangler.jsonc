{
  // TABI 部署到 Cloudflare Workers 的配置。合并到 main 后由 Workers Builds 自动部署；手动部署：npm run deploy
  "name": "tabi-memo",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-11-16",
  // 每次部署前先重新打包
  "build": { "command": "node scripts/build.mjs" },
  // 页面、样式、图片由 Cloudflare 直接提供；只有 /api/* 会运行 Worker
  "assets": { "directory": "./dist/public" },
  // 位置缓存与每日额度计数。id 是线上那个存储空间（tabi-memo-tabi-kv），写死在这里，从任何电脑部署都用同一个
  "kv_namespaces": [{ "binding": "TABI_KV", "id": "8dc5c757ae8741e38afb057bfc4c1207" }],
  // 每个 IP 每分钟最多 20 次接口请求
  "ratelimits": [{ "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  // DAILY_SEARCH_LIMIT：所有访客每天合计最多联网搜索多少次。平时 30 次/天约等于每月 900 次，对应 Tavily 免费额度；
  //   2026 年 11 月的额度在开发测试中已用掉八成以上，暂时降到 10，Tavily 额度重置后改回 30。
  // DAILY_AI_LIMIT：所有访客每天合计最多调用模型多少次。用完后各功能退回规则版，保护 DeepSeek 的预付费余额。
  "vars": { "DAILY_SEARCH_LIMIT": "10", "DAILY_AI_LIMIT": "100" },
  // 这两个密钥用 wrangler secret put 设置，不写在这里
  "secrets": { "required": ["DEEPSEEK_API_KEY", "TAVILY_API_KEY"] },
  "observability": { "enabled": true }
}
